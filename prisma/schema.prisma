// Darknote Nexus — production schema (PostgreSQL)
// Portable subset: no enums / arrays so the same models run on SQLite for local verification.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatar       String   @default("")
  role         String   @default("USER") // USER | ADMIN
  status       String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?

  sessions     Session[]
  whatsapp     WhatsAppSession[]
  notes        Note[]
  bots         Bot[]
  files        FileAsset[]
  integrations Integration[]
  auditLogs    AuditLog[]
}

model Session {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String   @default("")
  ip         String   @default("")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("")
  body      String   @default("")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model Bot {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String   @default("")
  tokenHash    String?  @unique
  tokenPrefix  String   @default("")
  status       String   @default("OFFLINE") // ONLINE | OFFLINE | PAUSED | ERROR
  enabled      Boolean  @default(true)
  pairedAt     DateTime?
  lastSeenAt   DateTime?
  version      String   @default("")
  messagesSent Int      @default(0)
  errors       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logs         BotLog[]
  whatsapp     WhatsAppSession[]
  commands     BotCommand[]
  @@index([userId])
}

model BotLog {
  id        String   @id @default(cuid())
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  level     String   @default("INFO") // INFO | WARN | ERROR
  message   String
  meta      String   @default("")
  createdAt DateTime @default(now())

  @@index([botId, createdAt])
}

model PairingCode {
  id        String    @id
  code      String    @unique
  userId    String
  botId     String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@index([botId])
}

model FileAsset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  size      Int
  data      String // base64 payload (<= 4MB)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Integration {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  baseUrl    String
  headerName String   @default("Authorization")
  keyPrefix  String   @default("")
  keyCipher  String
  status     String   @default("UNTESTED") // UNTESTED | OK | FAILED
  lastTestAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String   @default("")
  meta      String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model WhatsAppSession {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId           String?   // set when the session is owned by an external bot agent
  bot             Bot?      @relation(fields: [botId], references: [id], onDelete: SetNull)
  source          String    @default("WORKER") // WORKER | BOT
  externalId      String    @default("")       // session id on the bot host
  pairRequestedAt DateTime?
  pairError       String    @default("")
  label           String
  phone           String    @default("") // digits only, E.164 without +
  status          String    @default("PAIRING_REQUESTED")
  // PAIRING_REQUESTED | PAIRING_CODE | CONNECTING | CONNECTED | DISCONNECTED
  // RECONNECT_REQUESTED | LOGGED_OUT | ERROR
  statusDetail    String    @default("")
  pairingCode     String    @default("")
  pairingExpiresAt DateTime?
  meJid           String    @default("")
  meNumber        String    @default("")
  platform        String    @default("")
  connectedAt     DateTime?
  lastSeenAt      DateTime?
  disconnectCount Int       @default(0)
  workerId        String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  keys WhatsAppKey[]
  logs WhatsAppLog[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([botId])
  @@unique([botId, externalId])
}

model WhatsAppKey {
  sessionId String
  keyId     String
  value     String // AES-256-GCM ciphertext of BufferJSON-serialised auth data
  session   WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, keyId])
}

model WhatsAppLog {
  id        String   @id @default(cuid())
  sessionId String
  session   WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  level     String   @default("INFO")
  message   String
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

model BotCommand {
  id          String    @id @default(cuid())
  botId       String
  bot         Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  sessionId   String?   // WhatsAppSession.id on this side
  type        String    // RESTART | LOGOUT
  status      String    @default("PENDING") // PENDING | DONE | ERROR
  result      String    @default("")
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  completedAt DateTime?

  @@index([botId, status])
}

// Darknote Setup / owner access

model SetupAccount {
  id                String    @id @default(cuid())
  username          String    @unique
  passwordHash      String
  phone             String    @default("") // E.164 with leading +
  displayName       String    @default("")
  status            String    @default("INVITED") // INVITED | PENDING | ACTIVE | SUSPENDED | REVOKED
  setupCodeHash     String
  setupCodePrefix   String    @default("")
  setupCodeIssuedAt DateTime  @default(now())
  setupCodeExpiresAt DateTime
  setupCodeUsedAt   DateTime?
  codeDelivery      String    @default("NOT_SENT") // NOT_SENT | SENT | FAILED
  codeDeliveryNote  String    @default("")
  userId            String? // linked main Nexus account
  createdById       String?
  activatedAt       DateTime?
  lastLoginAt       DateTime?
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  requests SetupAccessRequest[]
  sessions SetupSession[]

  @@index([status])
  @@index([userId])
}

model SetupAccessRequest {
  id             String       @id @default(cuid())
  setupAccountId String
  account        SetupAccount @relation(fields: [setupAccountId], references: [id], onDelete: Cascade)
  userId         String?
  status         String       @default("PENDING") // PENDING | APPROVED | REJECTED
  note           String       @default("")
  decidedById    String?
  createdAt      DateTime     @default(now())
  decidedAt      DateTime?

  @@index([status, createdAt])
  @@index([setupAccountId])
}

model SetupSession {
  id             String        @id
  setupAccountId String?
  account        SetupAccount? @relation(fields: [setupAccountId], references: [id], onDelete: Cascade)
  ownerUserId    String?
  role           String        @default("USER") // OWNER | USER
  tokenHash      String        @unique
  ip             String        @default("")
  userAgent      String        @default("")
  createdAt      DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  @@index([setupAccountId])
  @@index([ownerUserId])
  @@index([expiresAt])
}

model OwnerCredential {
  id          String   @id @default("owner")
  tokenHash   String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// WhatsApp outbound queue

model WhatsAppOutbox {
  id        String    @id @default(cuid())
  sessionId String
  to        String // digits only, no +
  body      String
  purpose   String    @default("")
  status    String    @default("QUEUED") // QUEUED | SENT | FAILED
  attempts  Int       @default(0)
  error     String    @default("")
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
  @@index([sessionId])
}
