{
  "name": "darknote-nexus",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:deploy": "node scripts/db-deploy.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "db:verify:strict": "node scripts/db-verify.mjs --strict",
    "vercel-build": "prisma generate && node scripts/db-deploy.mjs --advisory && node scripts/db-verify.mjs --quiet --gate && next build",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.mjs",
    "e2e": "node scripts/e2e.mjs",
    "worker": "node worker/index.mjs",
    "worker:test": "node scripts/test-worker.mjs",
    "worker:fixture": "node scripts/fixture-worker.mjs",
    "e2e:bot": "node scripts/e2e-bot-api.mjs",
    "e2e:cors": "node scripts/e2e-cors.mjs",
    "e2e:setup": "node scripts/e2e-setup.mjs",
    "db:verify:gate": "node scripts/db-verify.mjs --strict --quiet --gate"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@whiskeysockets/baileys": "^6.7.24",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "prisma": "5.22.0",
    "typescript": "5.6.3"
  }
}
