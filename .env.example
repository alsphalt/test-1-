# ── Database ────────────────────────────────────────────────────────────────
# Any PostgreSQL works: Vercel Postgres, Neon, Supabase, RDS.
# Pooled URL for the app (serverless), direct URL for migrations.
DATABASE_URL="postgresql://user:password@host:5432/darknote?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/darknote?sslmode=require"

# Local development without Postgres (SQLite):
#   1. cp prisma/schema.prisma prisma/schema.local.prisma  (provider -> "sqlite", drop directUrl)
#   2. DATABASE_URL="file:./dev.db" npx prisma db push --schema prisma/schema.local.prisma
#   3. npx prisma generate --schema prisma/schema.local.prisma

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random chars, signs the HTTP-only session cookie.  openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string-min-32-chars"

# ── Secrets encryption ──────────────────────────────────────────────────────
# 32 bytes (hex or base64) used for AES-256-GCM on stored integration keys.
#   openssl rand -hex 32
ENCRYPTION_KEY="replace-me-with-64-hex-chars"

# ── Bootstrap ───────────────────────────────────────────────────────────────
# Comma-separated emails that are granted ADMIN on registration.
ADMIN_EMAILS="you@example.com"
# Public origin — used for absolute links and origin checks.
APP_URL="https://your-app.vercel.app"

# ── Browser origins (CORS) ─────────────────────────────────────────────────
# The UI calls /api on the same origin by default. Add any extra origins that
# must be allowed to call the API with cookies — exact origins only, never "*".
#   ALLOWED_ORIGINS="https://darknote.vercel.app,https://darknote-git-main-you.vercel.app"
ALLOWED_ORIGINS=""
# Only when the UI is deployed apart from the API (sets credentials: include).
# NEXT_PUBLIC_API_BASE="https://api.example.com"
# lax (default) | none — "none" is required for cross-site cookies and needs HTTPS
# COOKIE_SAMESITE="lax"

# ── Optional: cross-instance pub/sub ───────────────────────────────────────
# Not required: the dashboard already falls back to a DB revision poll inside
# the SSE stream. Add these if you want instant fan-out on many instances.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ── WhatsApp worker (worker/index.mjs) ─────────────────────────────────────
# The worker needs the same DATABASE_URL and ENCRYPTION_KEY as the web app.
# Run it on a long-lived host; Vercel functions cannot hold the socket.
# Optional, only for identifying instances in WhatsAppSession.workerId:
# WORKER_ID="wa-worker-1"

# ── Darknote Setup (owner administration) ──────────────────────────────────
# Emails treated as owner accounts. Ownership still requires signing in to that
# account AND the owner setup token — the email alone grants nothing.
OWNER_EMAILS="alsphaltjimna@gmail.com,welkamals@gmail.com,darknotjimna@gmail.com,jimnaals@gmail.com"
# Seed used once to create the owner credential. Only its bcrypt hash is stored.
# Rotate it in Setup → Security, then remove this variable from production.
OWNER_SETUP_TOKEN="set-your-owner-token"
# Server-enforced idle timeout for an unlocked Setup session (minutes).
SETUP_IDLE_MINUTES="20"
# How long an issued personal setup code stays valid (hours).
SETUP_CODE_TTL_HOURS="72"
# Accept the deployment's own *.vercel.app preview hosts as API origins.
ALLOW_VERCEL_PREVIEWS="true"

# ── v0 / preview embedding ─────────────────────────────────────────────────
# v0 previews render the app inside an iframe. Keep the default (deny framing)
# for production; for a v0 preview add its origins, e.g.
#   FRAME_ANCESTORS="'self' https://*.v0.app https://v0.dev"
# When this is not "'self'", X-Frame-Options is replaced by a CSP frame-ancestors
# policy, because X-Frame-Options cannot express a list.
FRAME_ANCESTORS="'self'"
