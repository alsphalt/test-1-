# ── Database ────────────────────────────────────────────────────────────────
# Any PostgreSQL works: Vercel Postgres, Neon, Supabase, RDS.
# Pooled URL for the app (serverless), direct URL for migrations.
DATABASE_URL="postgresql://user:password@host:5432/darknote?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/darknote?sslmode=require"

# Local development without Postgres (SQLite):
#   1. cp prisma/schema.prisma prisma/schema.local.prisma  (provider -> "sqlite", drop directUrl)
#   2. DATABASE_URL="file:./dev.db" npx prisma db push --schema prisma/schema.local.prisma
#   3. npx prisma generate --schema prisma/schema.local.prisma

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random chars, signs the HTTP-only session cookie.  openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string-min-32-chars"

# ── Secrets encryption ──────────────────────────────────────────────────────
# 32 bytes (hex or base64) used for AES-256-GCM on stored integration keys.
#   openssl rand -hex 32
ENCRYPTION_KEY="replace-me-with-64-hex-chars"

# ── Bootstrap ───────────────────────────────────────────────────────────────
# Comma-separated emails that are granted ADMIN on registration.
ADMIN_EMAILS="you@example.com"
# Public origin — used for absolute links and origin checks.
APP_URL="https://your-app.vercel.app"

# ── Optional: cross-instance pub/sub ───────────────────────────────────────
# Not required: the dashboard already falls back to a DB revision poll inside
# the SSE stream. Add these if you want instant fan-out on many instances.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
